{
  "json.schemas": [
    {
      "fileMatch": [
        "*caddy*.json"
      ],
      "url": ".vscode/caddy_schema.json"
    }
  ],
  "yaml.schemas": {
    ".vscode/caddy_schema.json": [
      "*caddy*.yaml",
      "*caddy*.yml"
    ]
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.venv": true,
    "**/__init__.py": false
  },
  "editor.formatOnSave": true,
  "ruff.nativeServer": "on",
  "ruff.trace.server": "messages",
  "ruff.configurationPreference": "filesystemFirst",
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.autoImportCompletions": true,
  "githubLocalActions.actCommand": "act --env ACTIONS_RUNTIME_TOKEN=foo  --artifact-server-path out",
}