{
    "configurations": [
        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "browserLaunchLocation": "ui",
            "disableNetworkCache": true,
            "url": "http://vite.localhost",
            "webRoot": "${workspaceFolder}/SM-Frontend"
        },
        {
            "name": "Python Debugger: Remote Attach",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/SM-Backend",
                    "remoteRoot": "/app"
                }
            ]
        },
        {
            "name": "Launch Chrome-storybook",
            "request": "launch",
            "type": "chrome",
            "browserLaunchLocation": "ui",
            "disableNetworkCache": true,
            "url": "http://localhost:6006",
            "webRoot": "${workspaceFolder}/SM-Frontend"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Current Test File",
            "autoAttachChildProcesses": true,
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "program": "${workspaceRoot}/node_modules/vitest/vitest.mjs",
            "args": [
                "run",
                "${relativeFile}"
            ],
            "smartStep": true,
            "console": "integratedTerminal"
        }
    ]
}